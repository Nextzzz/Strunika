<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Strunika.Mobile.ViewModels"
             x:Class="Strunika.Mobile.MainPage"
             x:DataType="vm:TunerViewModel"
             BackgroundColor="#1E1E24"
             Title="Тюнер">

    <VerticalStackLayout Spacing="22" Padding="30" VerticalOptions="Center">

        <Label Text="{Binding NoteName}"
               FontSize="120" FontAttributes="Bold"
               HorizontalOptions="Center">
            <Label.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding InTune}" Value="True">
                    <Setter Property="TextColor" Value="#5BD98A"/>
                </DataTrigger>
                <DataTrigger TargetType="Label" Binding="{Binding InTune}" Value="False">
                    <Setter Property="TextColor" Value="#EAEAEA"/>
                </DataTrigger>
            </Label.Triggers>
        </Label>

        <!-- Scale: 300 px track = ±50 cents; green zone = ±8 cents;
             the needle slides by NeedleOffset (3 px per cent). -->
        <Grid WidthRequest="300" HeightRequest="60" HorizontalOptions="Center">
            <BoxView WidthRequest="300" HeightRequest="4" Color="#3A3F4A"
                     VerticalOptions="Center" HorizontalOptions="Center"/>
            <BoxView WidthRequest="48" HeightRequest="14" Color="#2E5E44" CornerRadius="4"
                     VerticalOptions="Center" HorizontalOptions="Center"/>
            <BoxView WidthRequest="2" HeightRequest="26" Color="#77808A"
                     VerticalOptions="Center" HorizontalOptions="Center"/>
            <BoxView WidthRequest="5" HeightRequest="44" CornerRadius="2"
                     VerticalOptions="Center" HorizontalOptions="Center"
                     TranslationX="{Binding NeedleOffset}">
                <BoxView.Triggers>
                    <DataTrigger TargetType="BoxView" Binding="{Binding InTune}" Value="True">
                        <Setter Property="Color" Value="#5BD98A"/>
                    </DataTrigger>
                    <DataTrigger TargetType="BoxView" Binding="{Binding InTune}" Value="False">
                        <Setter Property="Color" Value="#6FB7FF"/>
                    </DataTrigger>
                </BoxView.Triggers>
            </BoxView>
        </Grid>
        <Grid ColumnDefinitions="*,*" WidthRequest="300" HorizontalOptions="Center">
            <Label Grid.Column="0" Text="♭ нижче" TextColor="#77808A" HorizontalOptions="Start"/>
            <Label Grid.Column="1" Text="вище ♯" TextColor="#77808A" HorizontalOptions="End"/>
        </Grid>

        <Label Text="{Binding Hint}" TextColor="#AAB2BC"
               FontSize="15" HorizontalOptions="Center"/>

        <Button Command="{Binding ToggleCommand}"
                BackgroundColor="#3A5C80" TextColor="#FFFFFF"
                FontSize="18" Padding="24,12" HorizontalOptions="Center">
            <Button.Triggers>
                <DataTrigger TargetType="Button" Binding="{Binding Listening}" Value="True">
                    <Setter Property="Text" Value="■ Стоп"/>
                </DataTrigger>
                <DataTrigger TargetType="Button" Binding="{Binding Listening}" Value="False">
                    <Setter Property="Text" Value="▶ Слухати"/>
                </DataTrigger>
            </Button.Triggers>
        </Button>
    </VerticalStackLayout>
</ContentPage>
