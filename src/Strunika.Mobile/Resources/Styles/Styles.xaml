<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:t="clr-namespace:Strunika.Mobile.Theme">

    <!--
    Typography: system font (SF Pro on iOS, Segoe on Windows) for all UI text;
    the display serif ("Display" / "DisplayBold", Vollkorn) only for chord names,
    the tuner note and large titles. Sizes follow the iOS text styles.
    -->

    <x:Double x:Key="SizeLargeTitle">34</x:Double>
    <x:Double x:Key="SizeTitle2">22</x:Double>
    <x:Double x:Key="SizeHeadline">17</x:Double>
    <x:Double x:Key="SizeBody">17</x:Double>
    <x:Double x:Key="SizeSubhead">15</x:Double>
    <x:Double x:Key="SizeFootnote">13</x:Double>
    <x:Double x:Key="SizeCaption">12</x:Double>

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BackgroundColor" Value="{t:Theme Bg}" />
    </Style>

    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{t:Theme Bg}" />
        <Setter Property="BarTextColor" Value="{t:Theme TextPri}" />
        <Setter Property="IconColor" Value="{t:Theme AccentText}" />
    </Style>

    <!-- Labels -->
    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{t:Theme TextPri}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="{StaticResource SizeBody}" />
        <Setter Property="FontAutoScalingEnabled" Value="True" />
    </Style>

    <Style TargetType="Label" x:Key="LargeTitle">
        <Setter Property="FontFamily" Value="Display" />
        <Setter Property="FontSize" Value="{StaticResource SizeLargeTitle}" />
        <Setter Property="TextColor" Value="{t:Theme TextPri}" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <Style TargetType="Label" x:Key="Title2">
        <Setter Property="FontFamily" Value="Display" />
        <Setter Property="FontSize" Value="{StaticResource SizeTitle2}" />
        <Setter Property="TextColor" Value="{t:Theme TextPri}" />
    </Style>

    <Style TargetType="Label" x:Key="Headline">
        <Setter Property="FontSize" Value="{StaticResource SizeHeadline}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{t:Theme TextPri}" />
    </Style>

    <Style TargetType="Label" x:Key="Subhead">
        <Setter Property="FontSize" Value="{StaticResource SizeSubhead}" />
        <Setter Property="TextColor" Value="{t:Theme TextSec}" />
    </Style>

    <Style TargetType="Label" x:Key="Footnote">
        <Setter Property="FontSize" Value="{StaticResource SizeFootnote}" />
        <Setter Property="TextColor" Value="{t:Theme TextSec}" />
    </Style>

    <Style TargetType="Label" x:Key="Caption">
        <Setter Property="FontSize" Value="{StaticResource SizeCaption}" />
        <Setter Property="TextColor" Value="{t:Theme TextSec}" />
    </Style>

    <!-- Small uppercase section label ("МОВА", "ІСТОРІЯ"). -->
    <Style TargetType="Label" x:Key="Eyebrow">
        <Setter Property="FontSize" Value="{StaticResource SizeCaption}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="1" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="TextColor" Value="{t:Theme TextSec}" />
    </Style>

    <!-- Chord names and the tuner note. -->
    <Style TargetType="Label" x:Key="ChordHero">
        <Setter Property="FontFamily" Value="DisplayBold" />
        <Setter Property="FontSize" Value="96" />
        <Setter Property="TextColor" Value="{t:Theme Accent}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="LineBreakMode" Value="NoWrap" />
        <Setter Property="FontAutoScalingEnabled" Value="False" />
    </Style>

    <Style TargetType="Label" x:Key="ChordSmall">
        <Setter Property="FontFamily" Value="DisplayBold" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="TextColor" Value="{t:Theme TextPri}" />
        <Setter Property="FontAutoScalingEnabled" Value="False" />
    </Style>

    <!-- Buttons -->
    <Style TargetType="Button" x:Key="ButtonBase">
        <Setter Property="TextColor" Value="{t:Theme OnFill}" />
        <Setter Property="BackgroundColor" Value="{t:Theme Fill}" />
        <Setter Property="FontSize" Value="{StaticResource SizeHeadline}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="HeightRequest" Value="50" />
        <Setter Property="MinimumWidthRequest" Value="44" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.45" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource ButtonBase}" />

    <Style TargetType="Button" x:Key="SecondaryButton" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="TextColor" Value="{t:Theme TextPri}" />
        <Setter Property="BackgroundColor" Value="{t:Theme Surface2}" />
    </Style>

    <!-- Compact pill button (filters, "Стрій · Стандарт ▾"). -->
    <Style TargetType="Button" x:Key="ChipButton" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="TextColor" Value="{t:Theme TextPri}" />
        <Setter Property="BackgroundColor" Value="{t:Theme Surface1}" />
        <Setter Property="BorderColor" Value="{t:Theme Separator}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="CornerRadius" Value="17" />
        <Setter Property="HeightRequest" Value="34" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <Style TargetType="Button" x:Key="ChipButtonSelected" BasedOn="{StaticResource ChipButton}">
        <Setter Property="TextColor" Value="{t:Theme OnFill}" />
        <Setter Property="BackgroundColor" Value="{t:Theme Fill}" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <!-- Surfaces -->
    <Style TargetType="Border" x:Key="BorderBase">
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="BackgroundColor" Value="{t:Theme Surface1}" />
    </Style>

    <Style TargetType="Border" BasedOn="{StaticResource BorderBase}" />

    <Style TargetType="Border" x:Key="Card" BasedOn="{StaticResource BorderBase}">
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style TargetType="Border" x:Key="Chip" BasedOn="{StaticResource BorderBase}">
        <Setter Property="StrokeShape" Value="RoundRectangle 17" />
        <Setter Property="Stroke" Value="{t:Theme Separator}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HeightRequest" Value="34" />
    </Style>

    <Style TargetType="BoxView">
        <Setter Property="Color" Value="{t:Theme Separator}" />
    </Style>

    <Style TargetType="BoxView" x:Key="SeparatorLine">
        <Setter Property="Color" Value="{t:Theme Separator}" />
        <Setter Property="HeightRequest" Value="1" />
    </Style>

    <!-- Controls -->
    <!-- Gold track when on; the off track is painted by the platform mappings in
         MauiProgram (Separator fill, Dim stroke). The knob is one cream colour in
         both states and both themes — like UISwitch's white knob — because a
         per-state thumb colour is not reliable across platforms. -->
    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{t:Theme Fill}" />
        <Setter Property="ThumbColor" Value="{StaticResource LightBase}" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{t:Theme Accent}" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{t:Theme TextPri}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="{StaticResource SizeBody}" />
        <Setter Property="PlaceholderColor" Value="{t:Theme TextSec}" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{t:Theme TextPri}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="{StaticResource SizeBody}" />
        <Setter Property="PlaceholderColor" Value="{t:Theme TextSec}" />
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="TextColor" Value="{t:Theme TextPri}" />
        <Setter Property="PlaceholderColor" Value="{t:Theme TextSec}" />
        <Setter Property="CancelButtonColor" Value="{t:Theme AccentText}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="{StaticResource SizeBody}" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{t:Theme TextPri}" />
        <Setter Property="TitleColor" Value="{t:Theme TextSec}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="{StaticResource SizeBody}" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="Slider">
        <Setter Property="MinimumTrackColor" Value="{t:Theme Accent}" />
        <Setter Property="MaximumTrackColor" Value="{t:Theme Separator}" />
        <Setter Property="ThumbColor" Value="{t:Theme Fill}" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{t:Theme Accent}" />
        <Setter Property="BackgroundColor" Value="{t:Theme Surface2}" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{t:Theme Accent}" />
    </Style>

    <Style TargetType="ImageButton">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{t:Theme TextPri}" />
        <Setter Property="FontSize" Value="{StaticResource SizeBody}" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{t:Theme Accent}" />
    </Style>

    <Style TargetType="SwipeItem">
        <Setter Property="BackgroundColor" Value="{t:Theme Error}" />
    </Style>

    <Style TargetType="Shadow">
        <Setter Property="Radius" Value="24" />
        <Setter Property="Opacity" Value="0.35" />
        <Setter Property="Brush" Value="{t:Theme Glow}" />
        <Setter Property="Offset" Value="0,8" />
    </Style>

    <Style TargetType="TabbedPage">
        <Setter Property="BarBackgroundColor" Value="{t:Theme Surface1}" />
        <Setter Property="BarTextColor" Value="{t:Theme AccentText}" />
        <Setter Property="UnselectedTabColor" Value="{t:Theme TextSec}" />
        <Setter Property="SelectedTabColor" Value="{t:Theme AccentText}" />
    </Style>

</ResourceDictionary>
