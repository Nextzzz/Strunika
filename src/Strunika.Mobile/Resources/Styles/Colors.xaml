<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
    Strunika brand tokens. Source of truth: .claude/skills/strunika-ui/SKILL.md §1.
    Pages never use raw hex: they use {AppThemeBinding Light={StaticResource LightX}, Dark={StaticResource DarkX}}
    or, better, one of the named styles in Styles.xaml.
    -->

    <!-- Brand -->
    <Color x:Key="Gold">#D9AC4C</Color>
    <Color x:Key="Copper">#AE6F32</Color>
    <Color x:Key="Cream">#E9D3A2</Color>
    <Color x:Key="DarkBase">#16110B</Color>
    <Color x:Key="LightBase">#FBF3E3</Color>

    <!-- Dark theme -->
    <Color x:Key="DarkBg">#16110B</Color>
    <Color x:Key="DarkSurface1">#211A10</Color>
    <Color x:Key="DarkSurface2">#2C2316</Color>
    <Color x:Key="DarkSeparator">#3A2E1C</Color>
    <Color x:Key="DarkTextPri">#E9D3A2</Color>
    <Color x:Key="DarkTextSec">#A48F66</Color>
    <Color x:Key="DarkDim">#7A6543</Color>
    <Color x:Key="DarkAccent">#D9AC4C</Color>
    <Color x:Key="DarkAccentText">#D9AC4C</Color>
    <Color x:Key="DarkAccent2">#AE6F32</Color>
    <Color x:Key="DarkFill">#D9AC4C</Color>
    <Color x:Key="DarkOnFill">#16110B</Color>
    <Color x:Key="DarkOnAccent">#16110B</Color>
    <Color x:Key="DarkGlow">#73D9AC4C</Color>
    <Color x:Key="DarkError">#C4533A</Color>

    <!-- Light theme -->
    <Color x:Key="LightBg">#FBF3E3</Color>
    <Color x:Key="LightSurface1">#F3E8CF</Color>
    <Color x:Key="LightSurface2">#E9D3A2</Color>
    <Color x:Key="LightSeparator">#D9C6A0</Color>
    <Color x:Key="LightTextPri">#16110B</Color>
    <Color x:Key="LightTextSec">#66522F</Color>
    <Color x:Key="LightDim">#A08A5C</Color>
    <Color x:Key="LightAccent">#AE6F32</Color>
    <Color x:Key="LightAccentText">#8A5424</Color>
    <Color x:Key="LightAccent2">#D9AC4C</Color>
    <Color x:Key="LightFill">#D9AC4C</Color>
    <Color x:Key="LightOnFill">#16110B</Color>
    <Color x:Key="LightOnAccent">#FFF8EC</Color>
    <Color x:Key="LightGlow">#4DAE6F32</Color>
    <Color x:Key="LightError">#A8402C</Color>

</ResourceDictionary>
