<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Strunika.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Strunika.Mobile"
    Title="Strunika"
    Shell.BackgroundColor="#2A2A33"
    Shell.ForegroundColor="#EAEAEA"
    Shell.TitleColor="#EAEAEA">

    <TabBar>
        <ShellContent Title="Тюнер"
                      ContentTemplate="{DataTemplate local:MainPage}"
                      Route="Tuner" />
        <ShellContent Title="Наживо"
                      ContentTemplate="{DataTemplate local:LivePage}"
                      Route="Live" />
    </TabBar>

</Shell>
