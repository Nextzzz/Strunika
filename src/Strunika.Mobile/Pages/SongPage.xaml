<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:t="clr-namespace:Strunika.Mobile.Theme"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             xmlns:loc="clr-namespace:Strunika.Mobile.Localization"
             xmlns:controls="clr-namespace:Strunika.Mobile.Controls"
             xmlns:vm="clr-namespace:Strunika.Mobile.ViewModels"
             x:Class="Strunika.Mobile.Pages.SongPage"
             x:DataType="vm:SongViewModel"
             NavigationPage.HasNavigationBar="False"
             NavigationPage.HasBackButton="False">

    <!-- Root: the whole screen. The body keeps the status-bar inset and lays its
         bottom out by hand (code-behind: transport just above the home indicator);
         the scrim and the sheet cover everything, safe area included — inside the
         padded body a strip under the sheet stayed undimmed. -->
    <Grid x:Name="Root" BackgroundColor="{t:Theme Bg}">
    <Grid x:Name="Body" Padding="0,8,0,20" RowDefinitions="44,Auto,Auto,3*,2*,Auto,Auto,Auto" RowSpacing="0">

        <!-- Header: back · title/artist · Chord Editor -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="8,0,12,0" ColumnSpacing="6" Margin="{t:ContentInset}">
            <HorizontalStackLayout Spacing="0" VerticalOptions="Center" MinimumHeightRequest="{t:Size 44, Min=44}" Padding="0,4">
                <controls:IconView Name="chevL" Size="{t:Size 27}" Color="{t:Theme AccentText}" VerticalOptions="Center" />
                <Label Text="{loc:Str Tab_Songs}" FontSize="18" TextColor="{t:Theme AccentText}" VerticalOptions="Center" />
                <HorizontalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnBackTapped" /></HorizontalStackLayout.GestureRecognizers>
            </HorizontalStackLayout>
            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                <Label Text="{Binding Title}" FontSize="17" FontAttributes="Bold" TextColor="{t:Theme TextPri}" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" MaxLines="1" />
                <Label Text="{Binding SubtitleText}" FontSize="12" TextColor="{t:Theme TextSec}" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" MaxLines="1" />
                <VerticalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnTitleTapped" /></VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>
            <Grid Grid.Column="2" HorizontalOptions="End" VerticalOptions="Center">
                <Border Style="{StaticResource Chip}" HeightRequest="{t:Size 40}" Padding="13,0" BackgroundColor="{t:Theme Fill}" Stroke="{t:Theme Fill}">
                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                        <controls:IconView Name="{Binding EditorGlyph}" Size="{t:Size 17}" Color="{t:Theme OnFill}" VerticalOptions="Center" />
                        <Label Text="{Binding EditorText}" FontSize="14" FontAttributes="Bold" TextColor="{t:Theme OnFill}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleEditorCommand}" /></Border.GestureRecognizers>
                </Border>
                <controls:LockBadge IsLocked="{Binding EditorLocked}" Margin="0,-6,-6,0" BackgroundColor="{t:Theme Fill}" IconColor="{t:Theme OnFill}" />
            </Grid>
        </Grid>

        <!-- Now playing · what is next: the name sits above its own box -->
        <Grid Grid.Row="3" x:Name="Panel" ColumnDefinitions="0,Auto,*,Auto,*,Auto,0" Padding="20,10,20,4" Margin="{t:ContentInset}">
            <Border Grid.Column="1" StrokeThickness="0" BackgroundColor="Transparent" Padding="0" HorizontalOptions="Center" VerticalOptions="Fill">
                <controls:ChordDiagram x:Name="CurrentDiagram" Shape="{Binding CurrentShape}" Title="{Binding CurrentChord}" ShowFrets="True" Capo="{Binding Capo}" LeftHanded="{Binding LeftHanded}"
                                       WidthRequest="{t:Size 168, Hero=True}" VerticalOptions="Fill"
                                       LineColor="{t:Theme TextPri}" DotColor="{t:Theme Accent}" MutedColor="{t:Theme Dim}"
                                       FretTextColor="{t:Theme TextSec}" TitleColor="{t:Theme AccentText}" />
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCurrentShapeTapped" /></Border.GestureRecognizers>
            </Border>

            <!-- Heavier than the default 1.8: it carries meaning here (what comes next), not just decoration. -->
            <controls:IconView Grid.Column="3" Name="chevR" Size="{t:Size 22}" StrokeSize="2.6" Color="{t:Theme Dim}" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding HasNext}" />

            <Border Grid.Column="5" StrokeThickness="0" BackgroundColor="Transparent" Padding="0" HorizontalOptions="Center" VerticalOptions="Fill" Opacity="0.7" IsVisible="{Binding HasNext}">
                <controls:ChordDiagram x:Name="NextDiagram" Shape="{Binding NextShape}" Title="{Binding NextChord}" ShowFrets="True" Capo="{Binding Capo}" LeftHanded="{Binding LeftHanded}"
                                       WidthRequest="{t:Size 100, Hero=True}" VerticalOptions="Fill" Margin="0,20"
                                       LineColor="{t:Theme TextSec}" DotColor="{t:Theme AccentText}" MutedColor="{t:Theme Dim}"
                                       FretTextColor="{t:Theme TextSec}" TitleColor="{t:Theme TextPri}" />
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnNextShapeTapped" /></Border.GestureRecognizers>
            </Border>
        </Grid>

        <!-- YouTube strip (collapsed player) -->
        <Border Grid.Row="1" x:Name="Strip" Style="{StaticResource Card}" Padding="6,0,8,0" HeightRequest="{t:Size 52, Min=44}" Margin="{t:ContentInset Plus=True, Top=12}" IsVisible="{Binding IsYouTube}">
            <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="10">
                <Border WidthRequest="{t:Size 40}" HeightRequest="{t:Size 40}" StrokeShape="RoundRectangle 9" StrokeThickness="0" Padding="0" VerticalOptions="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{t:Theme Accent2}" Offset="0" />
                            <GradientStop Color="{t:Theme Surface2}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <controls:IconView Name="youtube" Size="{t:Size 20}" Color="{t:Theme TextPri}" HorizontalOptions="Center" VerticalOptions="Center" />
                        <Image x:Name="Thumb" Aspect="AspectFill" />
                    </Grid>
                </Border>
                <Label Grid.Column="1" FontSize="13" TextColor="{t:Theme TextSec}" VerticalOptions="Center" LineBreakMode="TailTruncation" MaxLines="1">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="YouTube" TextColor="{t:Theme TextPri}" FontAttributes="Bold" />
                            <Span Text=" · " />
                            <Span Text="{Binding Title}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <controls:IconView Grid.Column="2" x:Name="PlayerChevron" Name="chevD" Size="{t:Size 18}" Color="{t:Theme TextSec}" VerticalOptions="Center" />
            </Grid>
            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPlayerStripTapped" /></Border.GestureRecognizers>
        </Border>
        <Border Grid.Row="2" x:Name="PlayerHost" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="0" Margin="{t:ContentInset Plus=True}" HeightRequest="1" Opacity="0" IsVisible="{Binding IsYouTube}">
            <controls:YouTubeEmbedView x:Name="Player" />
        </Border>

        <!-- The whole song at a glance, over the editor's track: where the chords
             are, where the playhead is, and which slice the track is looking at.
             Beside it, the way back to the playhead when the track has been let
             go of (user request 2026-09-10). -->
        <VerticalStackLayout Grid.Row="3" x:Name="MapRow" Spacing="6" Padding="20,4,20,6" Margin="{t:ContentInset}" IsVisible="False">
            <controls:SongMap x:Name="Map" Duration="{Binding Duration}" Segments="{Binding Segments}"
                              RailColor="{t:Theme Separator}" MarkColor="{t:Theme Dim}" Accent="{t:Theme Accent}" />
            <!-- (The beat view scrolls itself, so it gets the chips without the map.) -->
            <!-- The two ways back: to the song, and to the chord being worked on.
                 A row of their own, so the map never shrinks to make room for
                 them (user request 2026-09-10). -->
            <HorizontalStackLayout Spacing="8">
                <Border x:Name="FollowChip" Style="{StaticResource Chip}" HeightRequest="{t:Size 34, Min=34}" Padding="10,0" IsVisible="False">
                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                        <controls:IconView Name="head" Size="{t:Size 15}" Color="{t:Theme AccentText}" VerticalOptions="Center" />
                        <Label Text="{loc:Str Song_Editor_Follow}" FontSize="13" FontAttributes="Bold" TextColor="{t:Theme AccentText}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnFollowTapped" /></Border.GestureRecognizers>
                </Border>
                <Border Style="{StaticResource Chip}" HeightRequest="{t:Size 34, Min=34}" Padding="10,0" IsVisible="{Binding HasSelection}">
                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                        <controls:IconView Name="pencil" Size="{t:Size 14}" Color="{t:Theme TextSec}" VerticalOptions="Center" />
                        <Label Text="{Binding SelectedChord}" FontFamily="Display" FontSize="14" TextColor="{t:Theme TextPri}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnGoToSelectionTapped" /></Border.GestureRecognizers>
                </Border>
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <!-- The beat grid (the other view of the same rows: chords by beat, tap to jump) -->
        <ScrollView Grid.Row="3" Grid.RowSpan="2" x:Name="GridHost" IsVisible="False" Padding="20,0" VerticalScrollBarVisibility="Default"
                    Margin="{t:ContentInset Top=18, Bottom=16}">
            <controls:BeatGrid x:Name="BeatsView"
                               Beats="{Binding BeatTimes}" Segments="{Binding Segments}" BeatsPerBar="{Binding BeatsPerBar}"
                               LoopStart="{Binding LoopStart}" LoopEnd="{Binding LoopEnd}"
                               Accent="{t:Theme Accent}" OnAccent="{t:Theme OnAccent}" CellColor="{t:Theme Surface1}"
                               ChordCellColor="{t:Theme Surface2}" TextColor="{t:Theme TextPri}" />
        </ScrollView>

        <!-- The grid dissolves into the background above the player instead of
             being cut off by it (the same 34 pt fade the tab bar uses). -->
        <Border Grid.Row="4" x:Name="GridShade" VerticalOptions="End" HeightRequest="{t:Size 34}" IsVisible="False"
                InputTransparent="True" StrokeThickness="0" StrokeShape="Rectangle" BackgroundColor="Transparent" />

        <!-- The conveyor -->
        <controls:ChordTrack Grid.Row="4" x:Name="Track" Margin="0,8,0,14" MinimumHeightRequest="{t:Size 110, Min=44}"
                             Segments="{Binding Segments}" Beats="{Binding BeatTimes}" Peaks="{Binding Peaks}"
                             Duration="{Binding Duration}"
                             LoopStart="{Binding LoopStart}" LoopEnd="{Binding LoopEnd}" LoopArmed="{Binding LoopArmed}"
                             Editing="{Binding Editing}" Selected="{Binding Selected}"
                             Accent="{t:Theme Accent}" OnAccent="{t:Theme OnAccent}" WaveColor="{t:Theme Surface2}"
                             PillColor="{t:Theme Surface2}" TextColor="{t:Theme TextPri}"
                             PinnedColor="{t:Theme Surface1}" PinnedTextColor="{t:Theme TextSec}" LineColor="{t:Theme Dim}" />

        <!-- The editor's own panel, over the song's slider: the chord being
             worked on and what can be done to it, with the two levels that
             matter while a song is being taken apart. It is deliberately
             generous — the track above gives up the room (user request
             2026-09-10). -->
        <Border Grid.Row="5" x:Name="EditorBar" Style="{StaticResource Card}" Padding="14,12" Margin="{t:ContentInset Plus=True, Top=2, Bottom=6}" IsVisible="{Binding Editing}">
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
                    <!-- A beat at a time, for when a finger is not exact enough.
                         Only there while a chord is (user request 2026-09-10). -->
                    <Border Style="{StaticResource Chip}" WidthRequest="{t:Size 44, Min=44}" HeightRequest="{t:Size 58, Min=54}" Padding="0" IsVisible="{Binding HasSelection}">
                        <controls:IconView Name="chevL" Size="{t:Size 20}" Color="{t:Theme TextPri}" HorizontalOptions="Center" VerticalOptions="Center" />
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnEditNudgeBack" /></Border.GestureRecognizers>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Chip}" WidthRequest="{t:Size 44, Min=44}" HeightRequest="{t:Size 58, Min=54}" Padding="0" IsVisible="{Binding HasSelection}">
                        <controls:IconView Name="chevR" Size="{t:Size 20}" Color="{t:Theme TextPri}" HorizontalOptions="Center" VerticalOptions="Center" />
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnEditNudgeOn" /></Border.GestureRecognizers>
                    </Border>
                    <!-- The chord being worked on: tap to put another in its place. -->
                    <Border Grid.Column="2" Style="{StaticResource Chip}" HeightRequest="{t:Size 58, Min=54}" Padding="16,0"
                            BackgroundColor="{t:Theme Fill}" Stroke="{t:Theme Fill}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="{Binding SelectedChord}" FontFamily="DisplayBold" FontSize="{t:Size 26, Hero=True}" TextColor="{t:Theme OnFill}"
                                   VerticalOptions="Center" LineBreakMode="TailTruncation" MaxLines="1" IsVisible="{Binding HasSelection}" />
                            <Label Text="{loc:Str Song_Editor_Nothing}" FontSize="14" TextColor="{t:Theme OnFill}" Opacity="0.75"
                                   VerticalOptions="Center" LineBreakMode="TailTruncation" MaxLines="2" IsVisible="{Binding HasSelection, Converter={StaticResource Not}}" />
                            <controls:IconView Grid.Column="1" Name="pencil" Size="{t:Size 18}" Color="{t:Theme OnFill}" VerticalOptions="Center" IsVisible="{Binding HasSelection}" />
                        </Grid>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnEditChord" /></Border.GestureRecognizers>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource Chip}" WidthRequest="{t:Size 58, Min=54}" HeightRequest="{t:Size 58, Min=54}" Padding="0"
                            Opacity="{Binding CanAdd, Converter={StaticResource Faded}}">
                        <controls:IconView Name="plus" Size="{t:Size 26}" Color="{t:Theme AccentText}" HorizontalOptions="Center" VerticalOptions="Center" />
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnEditAdd" /></Border.GestureRecognizers>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource Chip}" WidthRequest="{t:Size 58, Min=54}" HeightRequest="{t:Size 58, Min=54}" Padding="0"
                            Opacity="{Binding HasSelection, Converter={StaticResource Faded}}">
                        <controls:IconView Name="trash" Size="{t:Size 24}" Color="{t:Theme Error}" HorizontalOptions="Center" VerticalOptions="Center" />
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnEditDelete" /></Border.GestureRecognizers>
                    </Border>
                </Grid>

                <!-- The song's own level -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" HeightRequest="{t:Size 38, Min=36}">
                    <controls:IconView Name="vol" Size="{t:Size 20}" Color="{t:Theme TextSec}" VerticalOptions="Center" />
                    <controls:SeekBar Grid.Column="1" Duration="1" Value="{Binding Volume, Mode=TwoWay}" TrackColor="{t:Theme Separator}" FillColor="{t:Theme Accent}" VerticalOptions="Center" Margin="0,0,6,0" />
                </Grid>

                <!-- The metronome and its own -->
                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12" HeightRequest="{t:Size 38, Min=36}">
                    <controls:IconView Name="metro" Size="{t:Size 20}" Color="{t:Theme TextSec}" VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding Metronome, Mode=TwoWay}" VerticalOptions="Center" />
                    <controls:SeekBar Grid.Column="2" Duration="1" Value="{Binding ClickVolume, Mode=TwoWay}" TrackColor="{t:Theme Separator}" FillColor="{t:Theme Accent}" VerticalOptions="Center" Margin="0,0,6,0" Opacity="{Binding Metronome, Converter={StaticResource Faded}}" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- Position slider. Each clock shares its cell with an invisible ghost of the
             widest clock the song can show, so the cell keeps one width: the font's
             digits are proportional (1:11 is narrower than 0:00) and the bar between the
             clocks used to stretch and shrink with every second. -->
        <Grid Grid.Row="6" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="22,0,22,0" Margin="{t:ContentInset}">
            <Label Text="{Binding TimeMask}" FontSize="12" Opacity="0" InputTransparent="True" VerticalOptions="Center" />
            <Label Text="{Binding PositionText}" FontSize="12" TextColor="{t:Theme TextSec}" VerticalOptions="Center" HorizontalOptions="End" />
            <controls:SeekBar Grid.Column="1" x:Name="Seeker" Duration="{Binding Duration}" TrackColor="{t:Theme Separator}" FillColor="{t:Theme Accent}" VerticalOptions="Center" />
            <Label Grid.Column="2" Text="{Binding TimeMask}" FontSize="12" Opacity="0" InputTransparent="True" VerticalOptions="Center" />
            <Label Grid.Column="2" Text="{Binding DurationText}" FontSize="12" TextColor="{t:Theme TextSec}" VerticalOptions="Center" HorizontalOptions="Start" />
        </Grid>

        <!-- Transport: metronome · chord skip · play · A–B -->
        <Grid Grid.Row="7" x:Name="Transport" Padding="18,10,18,16" Margin="{t:ContentInset}">
            <Grid VerticalOptions="Center" HorizontalOptions="Start" IsVisible="{Binding Editing, Converter={StaticResource Not}}">
                <Border x:Name="LoopChip" Style="{StaticResource Chip}" HeightRequest="{t:Size 46, Min=44}" Padding="16,0">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding LoopActive}" Value="True">
                            <Setter Property="BackgroundColor" Value="{t:Theme Fill}" />
                            <Setter Property="Stroke" Value="{t:Theme Fill}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Text="{Binding LoopText}" FontSize="15" FontAttributes="Bold" TextColor="{t:Theme TextPri}" VerticalOptions="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding LoopActive}" Value="True">
                                <Setter Property="TextColor" Value="{t:Theme OnFill}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleLoopCommand}" /></Border.GestureRecognizers>
                </Border>
                <controls:LockBadge IsLocked="{Binding LoopLocked}" Margin="0,-6,-6,0" BackgroundColor="{t:Theme Fill}" IconColor="{t:Theme OnFill}" />
            </Grid>

            <!-- The A–B chip's place while the editor is on. A loop is for
                 playing a part over and over; editing, the one thing there is no
                 other way to do is take a change back — and every change here is
                 written to the song at once (user decision 2026-09-10). -->
            <Border HorizontalOptions="Start" WidthRequest="{t:Size 56, Min=44}" HeightRequest="{t:Size 56, Min=44}"
                    StrokeShape="{t:Round 56, Min=44}" StrokeThickness="0" BackgroundColor="{t:Theme Surface1}"
                    Padding="0" VerticalOptions="Center" IsVisible="{Binding Editing}"
                    Opacity="{Binding CanUndo, Converter={StaticResource Faded}}">
                <controls:IconView Name="undo" Size="{t:Size 24}" Color="{t:Theme TextPri}" HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding UndoCommand}" /></Border.GestureRecognizers>
            </Border>

            <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
            <Border WidthRequest="{t:Size 60, Min=44}" HeightRequest="{t:Size 60, Min=44}" StrokeShape="{t:Round 60, Min=44}" StrokeThickness="0" BackgroundColor="Transparent" Padding="0" VerticalOptions="Center">
                <controls:IconView Name="prevCh" Size="{t:Size 28}" Color="{t:Theme TextPri}" HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding PrevChordCommand}" /></Border.GestureRecognizers>
            </Border>
            <Border WidthRequest="{t:Size 78, Min=44}" HeightRequest="{t:Size 78, Min=44}" StrokeShape="{t:Round 78, Min=44}" StrokeThickness="0" BackgroundColor="{t:Theme Fill}" Padding="0" VerticalOptions="Center">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding CanPlay}" Value="False">
                        <Setter Property="Opacity" Value="0.35" />
                    </DataTrigger>
                </Border.Triggers>
                <Border.Shadow><Shadow Brush="{t:Theme Glow, Brush=True}" Radius="12" Opacity="0.7" Offset="0,5" /></Border.Shadow>
                <Grid>
                    <controls:IconView Name="play" Size="{t:Size 34}" Color="{t:Theme OnFill}" HorizontalOptions="Center" VerticalOptions="Center" Margin="4,0,0,0" IsVisible="{Binding ShowPause, Converter={StaticResource Not}}" />
                    <controls:IconView Name="pause" Size="{t:Size 32}" Color="{t:Theme OnFill}" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding ShowPause}" />
                </Grid>
                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding TogglePlayCommand}" /></Border.GestureRecognizers>
            </Border>
            <Border WidthRequest="{t:Size 60, Min=44}" HeightRequest="{t:Size 60, Min=44}" StrokeShape="{t:Round 60, Min=44}" StrokeThickness="0" BackgroundColor="Transparent" Padding="0" VerticalOptions="Center">
                <controls:IconView Name="nextCh" Size="{t:Size 28}" Color="{t:Theme TextPri}" HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding NextChordCommand}" /></Border.GestureRecognizers>
            </Border>
            </HorizontalStackLayout>

            <Border HorizontalOptions="End" WidthRequest="{t:Size 56, Min=44}" HeightRequest="{t:Size 56, Min=44}" StrokeShape="{t:Round 56, Min=44}" StrokeThickness="0" BackgroundColor="{t:Theme Surface1}" Padding="0" VerticalOptions="Center" IsVisible="{Binding Editing, Converter={StaticResource Not}}">
                <controls:IconView Name="dots" Size="{t:Size 24}" Color="{t:Theme TextPri}" HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnMoreTapped" /></Border.GestureRecognizers>
            </Border>
            <!-- The editor has no use for the sheet: the two levels are on its own
                 panel, so the place goes to the switch between the two views. -->
            <Border HorizontalOptions="End" WidthRequest="{t:Size 56, Min=44}" HeightRequest="{t:Size 56, Min=44}" StrokeShape="{t:Round 56, Min=44}" StrokeThickness="0" BackgroundColor="{t:Theme Surface1}" Padding="0" VerticalOptions="Center" IsVisible="{Binding Editing}">
                <controls:IconView x:Name="ViewSwitchIcon" Name="grid4" Size="{t:Size 24}" Color="{t:Theme TextPri}" HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnViewSwitchTapped" /></Border.GestureRecognizers>
            </Border>
        </Grid>


    </Grid>

        <!-- "More": everything that is not needed on every bar -->
        <BoxView x:Name="MoreScrim" Color="#99000000" Opacity="0" InputTransparent="True">
            <BoxView.GestureRecognizers><TapGestureRecognizer Tapped="OnMoreTapped" /></BoxView.GestureRecognizers>
        </BoxView>

        <!-- Bottom padding is set in code: 24 pt plus the home indicator. -->
        <!-- Put away in code by its own measured height (SongPage.xaml.cs): a
             flat number here is a guess, and a sheet taller than the guess keeps
             a strip of itself on screen. -->
        <Border x:Name="MoreSheet" VerticalOptions="End" Margin="{t:ContentInset}"
                BackgroundColor="{t:Theme Surface1}" StrokeThickness="0" Padding="20,10,20,24"
                StrokeShape="RoundRectangle 24,24,0,0">
            <Border.Shadow><Shadow Brush="#40000000" Radius="22" Opacity="0.6" Offset="0,-6" /></Border.Shadow>
            <VerticalStackLayout Spacing="4">
                <BoxView WidthRequest="{t:Size 40}" HeightRequest="{t:Size 5}" CornerRadius="3" Color="{t:Theme Separator}" HorizontalOptions="Center" Margin="0,0,0,8" />

                <!-- How the song is shown: the moving conveyor, or its beats as a
                     grid. It comes before the tools: it changes the whole page. -->
                <Border x:Name="ModeRow" StrokeShape="{t:Round 44}" StrokeThickness="1" Stroke="{t:Theme Separator}" BackgroundColor="{t:Theme Surface2}"
                        Padding="5" HorizontalOptions="Center" Margin="0,2,0,10">
                    <HorizontalStackLayout Spacing="6">
                        <Border x:Name="ConveyorSeg" WidthRequest="{t:Size 72, Min=56}" HeightRequest="{t:Size 46, Min=44}" StrokeShape="{t:Round 36}" StrokeThickness="0" Padding="0">
                            <controls:IconView x:Name="ConveyorIcon" Name="conveyor" Size="{t:Size 30}" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnConveyorModeTapped" /></Border.GestureRecognizers>
                        </Border>
                        <Border x:Name="GridSeg" WidthRequest="{t:Size 72, Min=56}" HeightRequest="{t:Size 46, Min=44}" StrokeShape="{t:Round 36}" StrokeThickness="0" Padding="0">
                            <controls:IconView x:Name="GridIcon" Name="grid4" Size="{t:Size 28}" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnGridModeTapped" /></Border.GestureRecognizers>
                        </Border>
                    </HorizontalStackLayout>
                </Border>

                <!-- Key: semitones from the original -->
                <Grid ColumnDefinitions="*,Auto" HeightRequest="{t:Size 52, Min=44}">
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Label Text="{loc:Str Song_Key_Full}" FontSize="16" TextColor="{t:Theme TextPri}" VerticalOptions="Center" />
                        <controls:LockBadge IsLocked="{Binding CapoLocked}" HorizontalOptions="Start" VerticalOptions="Center" Margin="0" BackgroundColor="{t:Theme Fill}" IconColor="{t:Theme OnFill}" />
                        <!-- Where the transposition has landed: Am → +1 → A♯m -->
                        <Border Style="{StaticResource Chip}" HeightRequest="{t:Size 30}" Padding="10,0" VerticalOptions="Center" IsVisible="{Binding HasKey}">
                            <!-- Centred on the glyph, not on the serif's line box. -->
                            <controls:GlyphLabel Text="{Binding KeyText}" FontFamily="Display" FontSize="14" TextColor="{t:Theme AccentText}"
                                                 HeightRequest="{t:Size 20}" MinimumWidthRequest="{t:Size 22}" VerticalOptions="Fill" />
                        </Border>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                        <Border WidthRequest="{t:Size 38}" HeightRequest="{t:Size 38}" StrokeShape="{t:Round 38}" StrokeThickness="0" BackgroundColor="{t:Theme Surface2}" Padding="0">
                            <controls:IconView Name="minus" Size="{t:Size 18}" Color="{t:Theme TextPri}" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding TransposeDownCommand}" /></Border.GestureRecognizers>
                        </Border>
                        <Label Text="{Binding TransposeText}" FontFamily="Display" FontSize="19" TextColor="{t:Theme AccentText}" HorizontalTextAlignment="Center" WidthRequest="{t:Size 46, Min=44}" VerticalOptions="Center" />
                        <Border WidthRequest="{t:Size 38}" HeightRequest="{t:Size 38}" StrokeShape="{t:Round 38}" StrokeThickness="0" BackgroundColor="{t:Theme Surface2}" Padding="0">
                            <controls:IconView Name="plus" Size="{t:Size 18}" Color="{t:Theme TextPri}" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding TransposeUpCommand}" /></Border.GestureRecognizers>
                        </Border>
                    </HorizontalStackLayout>
                </Grid>

                <!-- Capo, with the position that opens the most chords -->
                <Grid ColumnDefinitions="*,Auto" HeightRequest="{t:Size 52, Min=44}">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="{loc:Str Song_Capo_Label}" FontSize="16" TextColor="{t:Theme TextPri}" VerticalOptions="Center" />
                        <controls:LockBadge IsLocked="{Binding CapoLocked}" HorizontalOptions="Start" VerticalOptions="Center" Margin="0" BackgroundColor="{t:Theme Fill}" IconColor="{t:Theme OnFill}" />
                        <Border Style="{StaticResource Chip}" HeightRequest="{t:Size 30}" Padding="10,0" VerticalOptions="Center" IsVisible="{Binding HasCapoSuggestion}">
                            <Label Text="{Binding CapoSuggestionText}" FontSize="13" TextColor="{t:Theme AccentText}" VerticalOptions="Center" />
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding UseSuggestedCapoCommand}" /></Border.GestureRecognizers>
                        </Border>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                        <Border WidthRequest="{t:Size 38}" HeightRequest="{t:Size 38}" StrokeShape="{t:Round 38}" StrokeThickness="0" BackgroundColor="{t:Theme Surface2}" Padding="0">
                            <controls:IconView Name="minus" Size="{t:Size 18}" Color="{t:Theme TextPri}" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding CapoDownCommand}" /></Border.GestureRecognizers>
                        </Border>
                        <Label Text="{Binding CapoNumberText}" FontFamily="Display" FontSize="19" TextColor="{t:Theme AccentText}" HorizontalTextAlignment="Center" WidthRequest="{t:Size 46}" VerticalOptions="Center" />
                        <Border WidthRequest="{t:Size 38}" HeightRequest="{t:Size 38}" StrokeShape="{t:Round 38}" StrokeThickness="0" BackgroundColor="{t:Theme Surface2}" Padding="0">
                            <controls:IconView Name="plus" Size="{t:Size 18}" Color="{t:Theme TextPri}" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding CapoUpCommand}" /></Border.GestureRecognizers>
                        </Border>
                    </HorizontalStackLayout>
                </Grid>

                <!-- Speed -->
                <Grid ColumnDefinitions="*,Auto" HeightRequest="{t:Size 52, Min=44}">
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Label Text="{loc:Str Song_Speed}" FontSize="16" TextColor="{t:Theme TextPri}" VerticalOptions="Center" />
                        <controls:LockBadge IsLocked="{Binding SpeedLocked}" HorizontalOptions="Start" VerticalOptions="Center" Margin="0" BackgroundColor="{t:Theme Fill}" IconColor="{t:Theme OnFill}" />
                    </HorizontalStackLayout>
                    <Picker Grid.Column="1" ItemsSource="{Binding SpeedOptions}" SelectedItem="{Binding SelectedSpeed, Mode=TwoWay}"
                            WidthRequest="{t:Size 110, Min=44}" FontSize="16" TextColor="{t:Theme TextPri}" HorizontalTextAlignment="End" VerticalOptions="Center" />
                </Grid>

                <!-- Simple chords: the same switch row as in Settings -->
                <Grid ColumnDefinitions="*,Auto" HeightRequest="{t:Size 52, Min=44}">
                    <Label Text="{loc:Str Song_Simple}" FontSize="16" TextColor="{t:Theme TextPri}" VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding SimpleChords, Mode=TwoWay}" VerticalOptions="Center" />
                </Grid>

                <!-- Metronome and how loud it is -->
                <Grid ColumnDefinitions="*,Auto" HeightRequest="{t:Size 52, Min=44}">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <controls:IconView Name="metro" Size="{t:Size 20}" Color="{t:Theme TextSec}" VerticalOptions="Center" />
                        <Label Text="{loc:Str Song_Click}" FontSize="16" TextColor="{t:Theme TextPri}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Switch Grid.Column="1" IsToggled="{Binding Metronome, Mode=TwoWay}" VerticalOptions="Center" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" HeightRequest="{t:Size 46, Min=44}" IsVisible="{Binding Metronome}">
                    <controls:IconView Name="vol" Size="{t:Size 18}" Color="{t:Theme Dim}" VerticalOptions="Center" Margin="2,0,0,0" />
                    <controls:SeekBar Grid.Column="1" Duration="1" Value="{Binding ClickVolume, Mode=TwoWay}" TrackColor="{t:Theme Separator}" FillColor="{t:Theme Accent}" VerticalOptions="Center" Margin="0,0,10,0" />
                </Grid>
                <!-- The tick lead, by ear (Expert settings only): plus if the tick sounds
                     late, minus if early — the player and the device add a delay of their own. -->
                <Grid ColumnDefinitions="*,Auto" HeightRequest="{t:Size 52, Min=44}" IsVisible="{Binding ShowClickOffset}">
                    <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                        <Label Text="{loc:Str Song_ClickOffset}" FontSize="16" TextColor="{t:Theme TextPri}" />
                        <Label Text="{loc:Str Song_ClickOffset_Hint}" Style="{StaticResource Footnote}" />
                    </VerticalStackLayout>
                    <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                        <Border WidthRequest="{t:Size 38}" HeightRequest="{t:Size 38}" StrokeShape="{t:Round 38}" StrokeThickness="0" BackgroundColor="{t:Theme Surface2}" Padding="0">
                            <controls:IconView Name="minus" Size="{t:Size 18}" Color="{t:Theme TextPri}" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ClickLaterCommand}" /></Border.GestureRecognizers>
                        </Border>
                        <Label Text="{Binding ClickOffsetText}" FontFamily="Display" FontSize="17" TextColor="{t:Theme AccentText}" HorizontalTextAlignment="Center" WidthRequest="{t:Size 64}" VerticalOptions="Center" />
                        <Border WidthRequest="{t:Size 38}" HeightRequest="{t:Size 38}" StrokeShape="{t:Round 38}" StrokeThickness="0" BackgroundColor="{t:Theme Surface2}" Padding="0">
                            <controls:IconView Name="plus" Size="{t:Size 18}" Color="{t:Theme TextPri}" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ClickEarlierCommand}" /></Border.GestureRecognizers>
                        </Border>
                    </HorizontalStackLayout>
                </Grid>

                <!-- Volume (for a YouTube song on iOS this is the device's own volume) -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" HeightRequest="{t:Size 52, Min=44}">
                    <controls:IconView Name="vol" Size="{t:Size 22}" Color="{t:Theme TextSec}" VerticalOptions="Center" />
                    <controls:SeekBar Grid.Column="1" Duration="1" Value="{Binding Volume, Mode=TwoWay}" TrackColor="{t:Theme Separator}" FillColor="{t:Theme Accent}" VerticalOptions="Center" Margin="0,0,10,0" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
