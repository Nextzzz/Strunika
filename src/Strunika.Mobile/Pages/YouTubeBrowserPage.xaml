<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:t="clr-namespace:Strunika.Mobile.Theme"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             xmlns:loc="clr-namespace:Strunika.Mobile.Localization"
             xmlns:controls="clr-namespace:Strunika.Mobile.Controls"
             x:Class="Strunika.Mobile.Pages.YouTubeBrowserPage"
             ios:Page.UseSafeArea="True"
             ios:Page.ModalPresentationStyle="FullScreen"
             NavigationPage.HasNavigationBar="False">

    <Grid BackgroundColor="{t:Theme Bg}" RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0" Padding="20,12,20,10" ColumnDefinitions="Auto,*,44" ColumnSpacing="10">
            <controls:IconView Name="youtube" Size="22" Color="{t:Theme AccentText}" VerticalOptions="Center" />
            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                <Label Text="YouTube" Style="{StaticResource Headline}" />
                <Label Text="{loc:Str YT_Hint}" Style="{StaticResource Footnote}" LineBreakMode="TailTruncation" MaxLines="1" />
            </VerticalStackLayout>
            <Border Grid.Column="2" WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 18" BackgroundColor="{t:Theme Surface2}" Padding="0" HorizontalOptions="End" VerticalOptions="Center">
                <controls:IconView Name="x" Size="18" Color="{t:Theme TextPri}" HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseTapped" /></Border.GestureRecognizers>
            </Border>
        </Grid>

        <WebView Grid.Row="1" x:Name="Web" Source="https://m.youtube.com/" Navigated="OnNavigated" />

        <Border Grid.Row="2" x:Name="AddBar" IsVisible="False" BackgroundColor="{t:Theme Surface1}" StrokeThickness="0" StrokeShape="Rectangle" Padding="20,12,20,24">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                    <Label x:Name="VideoTitle" FontSize="15" FontAttributes="Bold" TextColor="{t:Theme TextPri}" LineBreakMode="TailTruncation" MaxLines="2" />
                    <Label x:Name="VideoUrl" Style="{StaticResource Caption}" LineBreakMode="MiddleTruncation" MaxLines="1" />
                </VerticalStackLayout>
                <Button Grid.Column="1" x:Name="AddButton" Text="{loc:Str YT_Add}" Clicked="OnAddTapped" HeightRequest="44" Padding="18,0" VerticalOptions="Center" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
