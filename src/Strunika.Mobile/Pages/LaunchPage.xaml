<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:t="clr-namespace:Strunika.Mobile.Theme"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             xmlns:loc="clr-namespace:Strunika.Mobile.Localization"
             xmlns:controls="clr-namespace:Strunika.Mobile.Controls"
             x:Class="Strunika.Mobile.Pages.LaunchPage"
             ios:Page.UseSafeArea="False"
             NavigationPage.HasNavigationBar="False">

    <!-- iOS shows its static launch screen (the mark, 256×142 pt, dead centre of
         the whole screen on the dark ground) before any of our code runs; it
         cannot be skipped. So this page puts the very same mark in the very same
         place — full-screen centre, safe area ignored, fixed points on purpose —
         and only the wordmark and the caption fade in around it: the two screens
         read as one. -->
    <Grid x:Name="Root" BackgroundColor="{t:Theme Bg}">
        <Image Source="{AppThemeBinding Light=strunika_mark_light.png, Dark=strunika_mark.png}" HeightRequest="142" WidthRequest="256" Aspect="AspectFit"
               HorizontalOptions="Center" VerticalOptions="Center" />
        <Label x:Name="Title" FontFamily="Display" FontSize="46" Text="Strunika" TextColor="{t:Theme TextPri}" HorizontalTextAlignment="Center"
               HorizontalOptions="Center" VerticalOptions="Center" TranslationY="112" Opacity="0" />
        <Label x:Name="Caption" Style="{StaticResource Footnote}" Text="{loc:Str Launch_Loading}" HorizontalTextAlignment="Center"
               VerticalOptions="End" Margin="24,0,24,64" Opacity="0" />
    </Grid>
</ContentPage>
