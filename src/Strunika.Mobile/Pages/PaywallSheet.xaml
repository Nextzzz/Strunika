<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:t="clr-namespace:Strunika.Mobile.Theme"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             xmlns:loc="clr-namespace:Strunika.Mobile.Localization"
             xmlns:controls="clr-namespace:Strunika.Mobile.Controls"
             x:Class="Strunika.Mobile.Pages.PaywallSheet"
             ios:Page.UseSafeArea="True"
             ios:Page.ModalPresentationStyle="FormSheet"
             NavigationPage.HasNavigationBar="False"
             NavigationPage.HasBackButton="False">

    <!-- No side padding on the root: the ScrollView spans the screen so the scroll
         indicator sits at the edge, right of the content; the 24 pt inset lives
         in the content and in the pinned header. -->
    <Grid BackgroundColor="{t:Theme Bg}" Padding="0,0,0,28" RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="14" Padding="24,96,24,8">

                <Border x:Name="FeatureCallout" StrokeShape="RoundRectangle 14" BackgroundColor="{t:Theme Surface2}" Padding="14,12" IsVisible="False">
                    <VerticalStackLayout Spacing="2">
                        <Label x:Name="FeatureName" Style="{StaticResource Headline}" />
                        <Label Style="{StaticResource Footnote}" Text="{loc:Str Pro_Locked_Body}" />
                    </VerticalStackLayout>
                </Border>

                <Label Style="{StaticResource Eyebrow}" Text="{loc:Str Pro_All}" />
                <VerticalStackLayout x:Name="FeatureList" Spacing="8" />

                <!-- Coming soon: the stem-separation family (Demucs) — three promises, one investment. -->
                <Label Style="{StaticResource Eyebrow}" Text="{loc:Str Pro_Soon}" Margin="0,14,0,0" />
                <Border Style="{StaticResource Card}" Padding="14,10" BackgroundColor="{t:Theme Surface1}" StrokeThickness="1" Stroke="{t:Theme Separator}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <controls:IconView Name="sliders" Size="18" Color="{t:Theme AccentText}" VerticalOptions="Start" Margin="0,2,0,0" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{loc:Str Pro_Soon_Stems}" FontSize="15" FontAttributes="Bold" TextColor="{t:Theme TextPri}" />
                                <Label Text="{loc:Str Pro_Soon_Stems_Hint}" Style="{StaticResource Caption}" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <Border Grid.Column="2" BackgroundColor="{t:Theme Surface2}" StrokeThickness="0" StrokeShape="RoundRectangle 9" Padding="8,2" VerticalOptions="Start">
                                <Label Text="{loc:Str Pro_Soon_Badge}" FontSize="11" FontAttributes="Bold" TextColor="{t:Theme AccentText}" />
                            </Border>
                        </Grid>
                        <BoxView Style="{StaticResource SeparatorLine}" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <controls:IconView Name="mic" Size="18" Color="{t:Theme AccentText}" VerticalOptions="Start" Margin="0,2,0,0" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{loc:Str Pro_Soon_Karaoke}" FontSize="15" FontAttributes="Bold" TextColor="{t:Theme TextPri}" />
                                <Label Text="{loc:Str Pro_Soon_Karaoke_Hint}" Style="{StaticResource Caption}" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <Border Grid.Column="2" BackgroundColor="{t:Theme Surface2}" StrokeThickness="0" StrokeShape="RoundRectangle 9" Padding="8,2" VerticalOptions="Start">
                                <Label Text="{loc:Str Pro_Soon_Badge}" FontSize="11" FontAttributes="Bold" TextColor="{t:Theme AccentText}" />
                            </Border>
                        </Grid>
                        <BoxView Style="{StaticResource SeparatorLine}" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <controls:IconView Name="wave" Size="18" Color="{t:Theme AccentText}" VerticalOptions="Start" Margin="0,2,0,0" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{loc:Str Pro_Soon_BassTabs}" FontSize="15" FontAttributes="Bold" TextColor="{t:Theme TextPri}" />
                                <Label Text="{loc:Str Pro_Soon_BassTabs_Hint}" Style="{StaticResource Caption}" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <Border Grid.Column="2" BackgroundColor="{t:Theme Surface2}" StrokeThickness="0" StrokeShape="RoundRectangle 9" Padding="8,2" VerticalOptions="Start">
                                <Label Text="{loc:Str Pro_Soon_Badge}" FontSize="11" FontAttributes="Bold" TextColor="{t:Theme AccentText}" />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">
                    <Border StrokeShape="RoundRectangle 16" StrokeThickness="2" Stroke="{t:Theme Accent}" BackgroundColor="{t:Theme Surface1}" Padding="14,12">
                        <VerticalStackLayout Spacing="2">
                            <HorizontalStackLayout Spacing="8">
                                <Label Style="{StaticResource Headline}" Text="{loc:Str Pro_Year}" />
                                <Border StrokeShape="RoundRectangle 8" BackgroundColor="{t:Theme Fill}" Padding="6,1" StrokeThickness="0">
                                    <Label Text="{loc:Str Pro_SaveYear}" FontSize="11" FontAttributes="Bold" TextColor="{t:Theme OnFill}" />
                                </Border>
                            </HorizontalStackLayout>
                            <Label Style="{StaticResource Title2}" Text="—" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" StrokeShape="RoundRectangle 16" StrokeThickness="1" Stroke="{t:Theme Separator}" BackgroundColor="{t:Theme Surface1}" Padding="14,12">
                        <VerticalStackLayout Spacing="2">
                            <Label Style="{StaticResource Headline}" Text="{loc:Str Pro_Month}" />
                            <Label Style="{StaticResource Title2}" Text="—" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
                <Label Style="{StaticResource Caption}" Text="{loc:Str Pro_PriceSoon}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Pinned header: the page background fading out downwards (gradient set in
             code, theme-aware), so content scrolling underneath dissolves gradually
             like under the tab bar. -->
        <Border x:Name="HeaderShade" Grid.Row="0" VerticalOptions="Start" HeightRequest="108" InputTransparent="True" StrokeThickness="0" StrokeShape="Rectangle" BackgroundColor="Transparent" />
        <Grid Grid.Row="0" VerticalOptions="Start" Padding="24,16,24,0" ColumnDefinitions="Auto,Auto,*,44" ColumnSpacing="0" HeightRequest="68">
            <Label Style="{StaticResource LargeTitle}" FontSize="32" VerticalOptions="Center">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Strunika " FontFamily="Display" />
                        <Span Text="Pro" FontFamily="Display" TextColor="{t:Theme AccentText}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <!-- The string-wave after "Pro", scaled with the title (54×20 at Title2 → 78×29 at 32 pt). -->
            <controls:WaveMark Grid.Column="1" Color="{t:Theme Accent}" GlowColor="{t:Theme Glow}" WidthRequest="78" HeightRequest="29" VerticalOptions="Center" Margin="10,2,0,0" />
            <Border Grid.Column="3" WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 18" BackgroundColor="{t:Theme Surface2}" Padding="0" HorizontalOptions="End" VerticalOptions="Center">
                <controls:IconView Name="x" Size="18" Color="{t:Theme TextPri}" HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseTapped" /></Border.GestureRecognizers>
            </Border>
        </Grid>

        <VerticalStackLayout Grid.Row="1" Spacing="12" Padding="24,12,24,0">
            <Button Text="{loc:Str Pro_Continue}" IsEnabled="False" />
            <HorizontalStackLayout Spacing="18" HorizontalOptions="Center">
                <Label Text="{loc:Str Pro_Restore}" Style="{StaticResource Footnote}" TextColor="{t:Theme AccentText}" FontAttributes="Bold" />
                <Label Text="{loc:Str Pro_Redeem}" Style="{StaticResource Footnote}" TextColor="{t:Theme AccentText}" FontAttributes="Bold" />
                <Label Text="{loc:Str Pro_Terms}" Style="{StaticResource Footnote}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
