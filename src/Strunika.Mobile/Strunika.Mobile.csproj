<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- iOS is the product target; the Windows head exists so UI and
		     view-models iterate on the PC without a phone attached. -->
		<TargetFrameworks>net9.0-ios</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net9.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>Strunika.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>Strunika</ApplicationTitle>
		<ApplicationId>app.strunika.mobile</ApplicationId>
		<ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<WindowsPackageType>None</WindowsPackageType>

		<!-- The iOS build is not trimmed. YoutubeExplode 6.6 has no net9.0 asset,
		     so a net9.0 project gets the net7.0 one, which carries file-local .NET
		     10 polyfills that the .NET 9 linker dies on (MT2231, "Collect Unmarked
		     Members"). Staying on 6.5 is not an option — 6.6 is what made YouTube
		     extraction work again (229941f) — and partial trimming does not help,
		     because the failing step walks every assembly regardless. The app is
		     bigger for it; the real fix is moving the project to net10.0, which is
		     a toolchain decision of its own. -->
		<PublishTrimmed Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">false</PublishTrimmed>


		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#16110B" BaseSize="256,142" />
		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />

		<!-- Neural models travel as raw assets; base stays for A/B, as on desktop. -->
		<!-- Model roster (see README.md):
		     btc_large_voca = base — LIVE play default;
		     btc_self       = self-trained (legally clean) — SONG analysis default;
		     btc_guitar2    = mic/solo option, selectable in live.
		     btc_full (HookTheory) is deliberately NOT bundled — NC licence. -->
		<MauiAsset Include="..\..\ml\models\btc_large_voca.onnx" LogicalName="models/btc_large_voca.onnx" />
		<MauiAsset Include="..\..\ml\models\btc_large_voca.json" LogicalName="models/btc_large_voca.json" />
		<MauiAsset Include="..\..\ml\models\btc_self.onnx" LogicalName="models/btc_self.onnx" />
		<MauiAsset Include="..\..\ml\models\btc_self.json" LogicalName="models/btc_self.json" />
		<MauiAsset Include="..\..\ml\models\btc_guitar2.onnx" LogicalName="models/btc_guitar2.onnx" />
		<MauiAsset Include="..\..\ml\models\btc_guitar2.json" LogicalName="models/btc_guitar2.json" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<!-- Song library: SQLite (segments as JSON per song) and on-device YouTube
		     metadata/audio extraction (plain YoutubeExplode on both platforms). -->
		<PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
		<PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.10" />
		<PackageReference Include="YoutubeExplode" Version="6.6.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Strunika.Core\Strunika.Core.csproj" />
		<ProjectReference Include="..\Strunika.Neural\Strunika.Neural.csproj" />
	</ItemGroup>

	<!-- The Windows head reuses the desktop capture (NAudio). -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<ProjectReference Include="..\Strunika.Media\Strunika.Media.csproj" />
	</ItemGroup>

</Project>
