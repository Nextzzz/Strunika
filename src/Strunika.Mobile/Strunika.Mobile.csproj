<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- iOS is the product target; the Windows head exists so UI and
		     view-models iterate on the PC without a phone attached. -->
		<!-- iOS is on net10.0 while Windows stays on net9.0: YoutubeExplode 6.6 has
		     no net9.0 asset, and the net7.0 one it falls back to carries .NET 10
		     polyfills that the .NET 9 trimmer cannot process (MT2231). The .NET 10
		     asset is clean and the .NET 10 linker understands it, so the iOS head
		     moved up; the Windows head kept MAUI 9 so the daily loop did not change. -->
		<TargetFrameworks>net10.0-ios</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net9.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>Strunika.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>Strunika</ApplicationTitle>
		<ApplicationId>app.strunika.mobile</ApplicationId>
		<ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<WindowsPackageType>None</WindowsPackageType>

		<!-- iOS is published without trimming, for now. The iOS workload's own
		     pre-mark linker step, "Collect Unmarked Members", dies on nested types
		     (MT2231: first YoutubeExplode's polyfill on .NET 9, then the compiler's
		     <PrivateImplementationDetails>/__StaticArrayInitTypeSize=82 on .NET 10);
		     it runs before MarkStep and records every type it sees through
		     Dictionary.Add, with no public report of the bug yet (workload
		     26.5.10315). The SDK's targets register that step only when TrimMode is
		     full/partial/link — MtouchLink=None makes it copy, so the step never
		     loads. The app is bigger for it; re-enable trimming when the workload
		     fixes the step (docs/ios-testflight.md has the trail). -->
		<MtouchLink Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">None</MtouchLink>

		<!-- Fast iOS builds (-p:StrunikaFastIos=true, the CI default): with no
		     trimming, AOT-compiling every method of every assembly took a 3-core
		     runner past an hour. Only our own assemblies are AOT-compiled; MAUI,
		     the BCL and the packages run in the Mono interpreter, and LLVM is off.
		     Allowed on the App Store, slower at runtime — meant for TestFlight
		     rounds, not the release build. -->
		<MtouchInterpreter Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' And '$(StrunikaFastIos)' == 'true'">all,-Strunika.Mobile,-Strunika.Core,-Strunika.Neural</MtouchInterpreter>
		<MtouchUseLlvm Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' And '$(StrunikaFastIos)' == 'true'">false</MtouchUseLlvm>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#16110B" BaseSize="256,142" />
		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />

		<!-- Neural models travel as raw assets; base stays for A/B, as on desktop. -->
		<!-- Model roster (see README.md):
		     btc_large_voca = base — LIVE play default;
		     btc_self       = self-trained (legally clean) — SONG analysis default;
		     btc_guitar2    = mic/solo option, selectable in live.
		     btc_full (HookTheory) is deliberately NOT bundled — NC licence. -->
		<MauiAsset Include="..\..\ml\models\btc_large_voca.onnx" LogicalName="models/btc_large_voca.onnx" />
		<MauiAsset Include="..\..\ml\models\btc_large_voca.json" LogicalName="models/btc_large_voca.json" />
		<MauiAsset Include="..\..\ml\models\btc_self.onnx" LogicalName="models/btc_self.onnx" />
		<MauiAsset Include="..\..\ml\models\btc_self.json" LogicalName="models/btc_self.json" />
		<MauiAsset Include="..\..\ml\models\btc_guitar2.onnx" LogicalName="models/btc_guitar2.onnx" />
		<MauiAsset Include="..\..\ml\models\btc_guitar2.json" LogicalName="models/btc_guitar2.json" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<!-- Song library: SQLite (segments as JSON per song) and on-device YouTube
		     metadata/audio extraction (plain YoutubeExplode on both platforms). -->
		<PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
		<PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.10" />
		<PackageReference Include="YoutubeExplode" Version="6.6.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Strunika.Core\Strunika.Core.csproj" />
		<ProjectReference Include="..\Strunika.Neural\Strunika.Neural.csproj" />
	</ItemGroup>

	<!-- The Windows head reuses the desktop capture (NAudio). -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<ProjectReference Include="..\Strunika.Media\Strunika.Media.csproj" />
	</ItemGroup>

</Project>
