<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:t="clr-namespace:Strunika.Mobile.Theme"
             xmlns:vm="clr-namespace:Strunika.Mobile.ViewModels"
             xmlns:loc="clr-namespace:Strunika.Mobile.Localization"
             xmlns:controls="clr-namespace:Strunika.Mobile.Controls"
             x:Class="Strunika.Mobile.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollView>
        <!-- {t:ContentInset}: a 560 pt column centred on a tablet, full width on phones -->
        <VerticalStackLayout Padding="20,8,20,104" Spacing="12" Margin="{t:ContentInset}">

            <!-- title · chord dictionary. The button keeps its size; on a narrow
                 screen the title truncates rather than the button being clipped. -->
            <!-- The title is never cut: when the two do not fit, the chip gives up
                 its word and keeps the icon (FitTitleRow). -->
            <Grid x:Name="TitleRow" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" SizeChanged="OnTitleRowSized">
                <Label x:Name="SettingsTitle" Style="{StaticResource LargeTitle}" Text="{loc:Str Tab_Settings}" HeightRequest="{t:Size 44, Min=44}" VerticalTextAlignment="End" />
                <Border Grid.Column="2" Style="{StaticResource Chip}" HeightRequest="{t:Size 40, Min=44}" Padding="12,0" VerticalOptions="End">
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <controls:IconView Name="songs" Size="{t:Size 18}" Color="{t:Theme AccentText}" VerticalOptions="Center" />
                        <Label x:Name="DictionaryLabel" Text="{loc:Str Settings_Dictionary}" FontSize="14" TextColor="{t:Theme AccentText}" VerticalOptions="Center" LineBreakMode="NoWrap" />
                    </HorizontalStackLayout>
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnDictionaryTapped" /></Border.GestureRecognizers>
                </Border>
            </Grid>

            <!-- Pro -->
            <Border StrokeShape="RoundRectangle 16" StrokeThickness="1" Stroke="{t:Theme Separator}" BackgroundColor="{t:Theme Surface2}" Padding="14,14,14,12">
                <VerticalStackLayout Spacing="8">
                    <!-- title · wave · button. The wave takes what is left between the
                         name and the button (FitProRow), and steps aside entirely when
                         there is not enough room for it to read as a string. -->
                    <Grid x:Name="ProRow" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="0" SizeChanged="OnProRowSized">
                        <Label x:Name="ProTitle" Style="{StaticResource Title2}" FontSize="{t:Size 22, Hero=True}" VerticalOptions="Center" LineBreakMode="TailTruncation" MaxLines="1">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Strunika " FontFamily="Display" />
                                    <Span Text="Pro" FontFamily="Display" TextColor="{t:Theme AccentText}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <!-- A tiny string-wave right after the word "Pro" (experimental, user request 2026-08-26). -->
                        <controls:WaveMark x:Name="ProWave" Grid.Column="1" Color="{t:Theme Accent}" GlowColor="{t:Theme Glow}" HeightRequest="{t:Size 20}" HorizontalOptions="Start" VerticalOptions="Center" Margin="8,3,12,0" />
                        <Button x:Name="ProButton" Grid.Column="2" Text="{loc:Str Pro_LearnMore}" FontSize="13" HeightRequest="{t:Size 32}" CornerRadius="16" Padding="12,0" MinimumWidthRequest="0" Clicked="OnProTapped" />
                    </Grid>
                    <Label Style="{StaticResource Footnote}" Text="{loc:Str Pro_Features}" LineBreakMode="WordWrap" />
                    <HorizontalStackLayout Spacing="16" Margin="0,2,0,0">
                        <Label Text="{loc:Str Pro_Restore}" FontSize="13" FontAttributes="Bold" TextColor="{t:Theme AccentText}" />
                        <Label Text="{loc:Str Pro_Redeem}" FontSize="13" FontAttributes="Bold" TextColor="{t:Theme AccentText}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Appearance -->
            <VerticalStackLayout Spacing="6">
                <Label Style="{StaticResource Eyebrow}" Text="{loc:Str Settings_Appearance}" Margin="14,0,0,0" />
                <Border Style="{StaticResource Group}">
                    <VerticalStackLayout>
                        <Grid Style="{StaticResource Row}" ColumnDefinitions="*,Auto,Auto,Auto">
                            <Label Style="{StaticResource RowLabel}" Text="{loc:Str Settings_Theme}" />
                            <controls:IconView Grid.Column="1" Name="{Binding ThemeIcon}" Size="{t:Size 16}" Color="{t:Theme TextSec}" VerticalOptions="Center" />
                            <Label Grid.Column="2" Style="{StaticResource RowValue}" Text="{Binding ThemeName}" />
                            <controls:IconView Grid.Column="3" Name="chevR" Size="{t:Size 16}" Color="{t:Theme TextSec}" VerticalOptions="Center" />
                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnThemeTapped" /></Grid.GestureRecognizers>
                        </Grid>
                        <BoxView Style="{StaticResource SeparatorLine}" Margin="14,0,0,0" />
                        <Grid Style="{StaticResource Row}" ColumnDefinitions="*,Auto,Auto,Auto">
                            <Label Style="{StaticResource RowLabel}" Text="{loc:Str Settings_Language}" />
                            <controls:IconView Grid.Column="1" Name="{Binding LanguageFlag}" Size="{t:Size 20}" Color="{t:Theme TextSec}" VerticalOptions="Center" />
                            <Label Grid.Column="2" Style="{StaticResource RowValue}" Text="{Binding LanguageName}" />
                            <controls:IconView Grid.Column="3" Name="chevR" Size="{t:Size 16}" Color="{t:Theme TextSec}" VerticalOptions="Center" />
                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnLanguageTapped" /></Grid.GestureRecognizers>
                        </Grid>
                        <BoxView Style="{StaticResource SeparatorLine}" Margin="14,0,0,0" />
                        <Grid Style="{StaticResource Row}" ColumnDefinitions="*,Auto">
                            <Label Style="{StaticResource RowLabel}" Text="{loc:Str Settings_LeftHanded}" />
                            <Switch Grid.Column="1" IsToggled="{Binding LeftHanded}" VerticalOptions="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource SeparatorLine}" Margin="14,0,0,0" />
                        <Grid Style="{StaticResource Row}" ColumnDefinitions="*,Auto">
                            <Label Style="{StaticResource RowLabel}" Text="{loc:Str Settings_SkipWelcome}" />
                            <Switch Grid.Column="1" IsToggled="{Binding SkipWelcome}" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Tuner -->
            <VerticalStackLayout Spacing="6">
                <Label Style="{StaticResource Eyebrow}" Text="{loc:Str Settings_Tuner}" Margin="14,0,0,0" />
                <Border Style="{StaticResource Group}">
                    <VerticalStackLayout>
                        <Grid Style="{StaticResource Row}" ColumnDefinitions="Auto,*,Auto,Auto">
                            <Label Style="{StaticResource RowLabel}" Text="{loc:Str Settings_A4}" />
                            <controls:LockBadge Grid.Column="0" IsLocked="{Binding A4Locked}" Margin="0,8,-16,0"
                                                BackgroundColor="{t:Theme Fill}" IconColor="{t:Theme OnFill}" />
                            <Label Grid.Column="2" Style="{StaticResource RowValue}" Text="{Binding A4Text}" />
                            <controls:IconView Grid.Column="3" Name="chevR" Size="{t:Size 16}" Color="{t:Theme TextSec}" VerticalOptions="Center" />
                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnA4Tapped" /></Grid.GestureRecognizers>
                        </Grid>
                        <BoxView Style="{StaticResource SeparatorLine}" Margin="14,0,0,0" />
                        <Grid Style="{StaticResource Row}" ColumnDefinitions="*,Auto,Auto">
                            <Label Style="{StaticResource RowLabel}" Text="{loc:Str Settings_DefaultTuning}" />
                            <Label Grid.Column="1" Style="{StaticResource RowValue}" Text="{Binding DefaultTuningName}" />
                            <controls:IconView Grid.Column="2" Name="chevR" Size="{t:Size 16}" Color="{t:Theme TextSec}" VerticalOptions="Center" />
                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnDefaultTuningTapped" /></Grid.GestureRecognizers>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Recognition -->
            <VerticalStackLayout Spacing="6">
                <Label Style="{StaticResource Eyebrow}" Text="{loc:Str Settings_Recognition}" Margin="14,0,0,0" />
                <Border Style="{StaticResource Group}">
                    <VerticalStackLayout>
                        <Grid Style="{StaticResource Row}" ColumnDefinitions="*,Auto">
                            <Label Style="{StaticResource RowLabel}" Text="{loc:Str Song_Simple}" />
                            <Switch Grid.Column="1" IsToggled="{Binding SimpleChords}" VerticalOptions="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource SeparatorLine}" Margin="14,0,0,0" />
                        <Grid Style="{StaticResource Row}" ColumnDefinitions="*,Auto">
                            <Label Style="{StaticResource RowLabel}" Text="{loc:Str Settings_BeatSnap}" />
                            <Switch Grid.Column="1" IsToggled="{Binding BeatSnap}" VerticalOptions="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource SeparatorLine}" Margin="14,0,0,0" />
                        <Grid Style="{StaticResource Row}" ColumnDefinitions="*,Auto">
                            <Label Style="{StaticResource RowLabel}" Text="{loc:Str Settings_Expert}" />
                            <Switch Grid.Column="1" IsToggled="{Binding Expert}" VerticalOptions="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource SeparatorLine}" Margin="14,0,0,0" IsVisible="{Binding DevProAvailable}" />
                        <Grid Style="{StaticResource Row}" ColumnDefinitions="*,Auto" IsVisible="{Binding DevProAvailable}">
                            <Label Style="{StaticResource RowLabel}" Text="{loc:Str Settings_DevPro}" />
                            <Switch Grid.Column="1" IsToggled="{Binding DevPro}" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- About -->
            <VerticalStackLayout Spacing="6">
                <Label Style="{StaticResource Eyebrow}" Text="{loc:Str Settings_About}" Margin="14,0,0,0" />
                <Border Style="{StaticResource Group}">
                    <VerticalStackLayout>
                        <Grid Style="{StaticResource Row}" ColumnDefinitions="*,Auto">
                            <Label Style="{StaticResource RowLabel}" Text="{loc:Str Settings_Version}" />
                            <Label Grid.Column="1" Style="{StaticResource RowValue}" Text="{Binding Version}" />
                        </Grid>
                        <BoxView Style="{StaticResource SeparatorLine}" Margin="14,0,0,0" IsVisible="{Binding DevWindowAvailable}" />
                        <Grid Style="{StaticResource Row}" ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding DevWindowAvailable}">
                            <Label Style="{StaticResource RowLabel}" Text="{loc:Str Settings_DevWindow}" />
                            <Label Grid.Column="1" Style="{StaticResource RowValue}" Text="{Binding DevWindowName}" />
                            <controls:IconView Grid.Column="2" Name="chevR" Size="{t:Size 16}" Color="{t:Theme TextSec}" VerticalOptions="Center" />
                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnDevWindowTapped" /></Grid.GestureRecognizers>
                        </Grid>
                        <BoxView Style="{StaticResource SeparatorLine}" Margin="14,0,0,0" />
                        <Grid Style="{StaticResource Row}" ColumnDefinitions="*,Auto">
                            <Label Style="{StaticResource RowLabel}" Text="{loc:Str Settings_Privacy}" />
                            <controls:IconView Grid.Column="1" Name="chevR" Size="{t:Size 16}" Color="{t:Theme TextSec}" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
