<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:t="clr-namespace:Strunika.Mobile.Theme"
             xmlns:vm="clr-namespace:Strunika.Mobile.ViewModels"
             xmlns:loc="clr-namespace:Strunika.Mobile.Localization"
             xmlns:controls="clr-namespace:Strunika.Mobile.Controls"
             x:Class="Strunika.Mobile.Views.LiveView"
             x:DataType="vm:LiveViewModel">

    <Grid Padding="20,8,20,104" RowDefinitions="44,Auto,*,Auto,Auto,Auto,Auto" RowSpacing="0">

        <HorizontalStackLayout Grid.Row="0" Spacing="0" VerticalOptions="End">
            <Label Style="{StaticResource LargeTitle}" Text="{loc:Str Tab_Live}" VerticalOptions="End" />
            <controls:ProSuffix IsVisible="{Binding IsPro}" />
        </HorizontalStackLayout>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
            <HorizontalStackLayout Spacing="7" VerticalOptions="Center">
                <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="{t:Theme Accent}" VerticalOptions="Center" IsVisible="{Binding Listening}" />
                <Label Style="{StaticResource Footnote}" Text="{Binding Status}" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Border Grid.Column="1" Style="{StaticResource Chip}" IsVisible="{Binding ExpertMode}">
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Label FontSize="14" Text="{loc:Str Live_Mode}" VerticalOptions="Center" />
                    <Label FontSize="14" Text="·" TextColor="{t:Theme TextSec}" VerticalOptions="Center" />
                    <Picker ItemsSource="{Binding LiveModels}" SelectedItem="{Binding SelectedLiveModel}"
                            FontSize="14" MinimumHeightRequest="30" MinimumWidthRequest="90" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <VerticalStackLayout Grid.Row="2" VerticalOptions="Center" Spacing="0">
            <Label Style="{StaticResource Subhead}" HorizontalTextAlignment="Center" MinimumHeightRequest="22" Text="{Binding GuessText}" />
            <Label Style="{StaticResource ChordHero}" Text="{Binding ConfirmedChord}" MinimumHeightRequest="120" />
        </VerticalStackLayout>

        <Label Grid.Row="3" Style="{StaticResource Eyebrow}" Text="{loc:Str Live_History}" Margin="0,0,0,6" />

        <CollectionView Grid.Row="4" ItemsSource="{Binding History}" HeightRequest="44" ItemsUpdatingScrollMode="KeepLastItemInView">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Border BackgroundColor="{t:Theme Surface2}" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="14,0" HeightRequest="36" VerticalOptions="Center">
                        <Label Style="{StaticResource ChordSmall}" FontSize="18" Text="{Binding .}" VerticalOptions="Center" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="5" ColumnDefinitions="Auto,*,Auto" Margin="0,16,0,0" ColumnSpacing="10">
            <Grid Grid.Column="0" VerticalOptions="Center">
                <Switch IsToggled="{Binding SimpleChords}" VerticalOptions="Center" />
                <controls:LockBadge IsLocked="{Binding FullVocabularyLocked}" Margin="0,-4,-4,0"
                                    BackgroundColor="{t:Theme Fill}" IconColor="{t:Theme OnFill}" />
            </Grid>
            <Label Grid.Column="1" Text="{loc:Str Live_SimpleChords}" FontSize="15" VerticalOptions="Center" LineBreakMode="TailTruncation" />
            <Border Grid.Column="2" Style="{StaticResource Chip}" HeightRequest="36" Opacity="0.6">
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <controls:IconView Name="metro" Size="18" Color="{t:Theme TextSec}" VerticalOptions="Center" />
                    <Label FontSize="14" Text="{loc:Str Live_Metronome}" TextColor="{t:Theme TextSec}" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <Button Grid.Row="6" Command="{Binding ToggleCommand}" Margin="0,14,0,0" Text="{loc:Str Common_Listen}">
            <Button.Triggers>
                <DataTrigger TargetType="Button" Binding="{Binding Listening}" Value="True">
                    <Setter Property="Text" Value="{loc:Str Common_Stop}" />
                    <Setter Property="BackgroundColor" Value="{t:Theme Surface2}" />
                    <Setter Property="TextColor" Value="{t:Theme TextPri}" />
                </DataTrigger>
            </Button.Triggers>
        </Button>
    </Grid>
</ContentView>
