<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:t="clr-namespace:Strunika.Mobile.Theme"
             xmlns:vm="clr-namespace:Strunika.Mobile.ViewModels"
             xmlns:loc="clr-namespace:Strunika.Mobile.Localization"
             xmlns:controls="clr-namespace:Strunika.Mobile.Controls"
             x:Class="Strunika.Mobile.Views.TunerView"
             x:DataType="vm:TunerViewModel">

    <Grid Padding="20,8,20,104" RowDefinitions="44,Auto,Auto,*,120,Auto,Auto" RowSpacing="0">

        <Grid Grid.Row="0">
            <HorizontalStackLayout Spacing="0" VerticalOptions="End">
                <Label Style="{StaticResource LargeTitle}" Text="{loc:Str Tab_Tuner}" VerticalOptions="End" />
                <controls:ProSuffix IsVisible="{Binding IsPro}" />
            </HorizontalStackLayout>
        </Grid>

        <HorizontalStackLayout Grid.Row="1" Spacing="8" Margin="0,14,0,0">
            <Border Style="{StaticResource Chip}">
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Label FontSize="14" Text="{loc:Str Tuner_Tuning}" VerticalOptions="Center" />
                    <Label FontSize="14" Text="·" TextColor="{t:Theme TextSec}" VerticalOptions="Center" />
                    <Label FontSize="14" Text="{Binding TuningName}" VerticalOptions="Center" />
                    <controls:IconView Name="chevD" Size="14" Color="{t:Theme TextSec}" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTuningTapped" />
                </Border.GestureRecognizers>
            </Border>
            <Grid>
                <Border Style="{StaticResource Chip}">
                    <Label FontSize="14" Text="{Binding A4Text}" TextColor="{t:Theme TextSec}" VerticalOptions="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnA4Tapped" />
                    </Border.GestureRecognizers>
                </Border>
                <controls:LockBadge IsLocked="{Binding A4Locked}" Margin="0,-6,-6,0" BackgroundColor="{t:Theme Fill}" IconColor="{t:Theme OnFill}" />
            </Grid>
        </HorizontalStackLayout>

        <!-- Hero: note + points while listening, an invitation while idle. -->
        <!-- "Start again": under the tuning selector (user request 2026-08-27), big enough to hit. -->
        <Border Grid.Row="2" Style="{StaticResource Chip}" HeightRequest="36" BackgroundColor="{t:Theme Fill}" Stroke="{t:Theme Fill}"
            HorizontalOptions="Start" Margin="0,10,0,0" IsVisible="{Binding ShowStartAgainChip}">
            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                <controls:IconView Name="undo" Size="16" Color="{t:Theme OnFill}" VerticalOptions="Center" />
                <Label FontSize="14" FontAttributes="Bold" Text="{loc:Str Tuner_StartAgain}" TextColor="{t:Theme OnFill}" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding StartAgainCommand}" />
            </Border.GestureRecognizers>
        </Border>

        <Grid Grid.Row="3">
            <VerticalStackLayout VerticalOptions="Center" Spacing="0" IsVisible="{Binding Listening}">
                <HorizontalStackLayout Spacing="7" HorizontalOptions="Center">
                    <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="{t:Theme Accent}" VerticalOptions="Center" />
                    <Label Style="{StaticResource Eyebrow}" Text="{loc:Str Tuner_Listening}" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label Style="{StaticResource ChordHero}" FontSize="140" Text="{Binding NoteName}" Margin="0,4,0,0" MinimumHeightRequest="160" />
                <Label Text="{Binding PointsText}" FontSize="52" FontAttributes="Bold" HorizontalTextAlignment="Center"
                       TextColor="{t:Theme TextPri}" MinimumHeightRequest="64" FontAutoScalingEnabled="False">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding InTune}" Value="True">
                            <Setter Property="TextColor" Value="{t:Theme AccentText}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </VerticalStackLayout>
            <Label x:Name="IdleLabel" Style="{StaticResource Title2}" FontSize="30" Text="{Binding IdleMessage}"
                   HorizontalTextAlignment="Center" VerticalOptions="Center" IsVisible="{Binding Listening, Converter={StaticResource Not}}" />
        </Grid>

        <controls:TunerString x:Name="StringIndicator" Grid.Row="4"
                              Cents="{Binding Cents}" InTune="{Binding InTune}" HasSignal="{Binding HasSignal}"
                              StringColor="{t:Theme Accent2}" InTuneColor="{t:Theme Accent}" IdleColor="{t:Theme Separator}"
                              ZoneColor="{t:Theme Glow}" TickColor="{t:Theme Dim}" LabelColor="{t:Theme TextSec}"
                              BeadCoreColor="{t:Theme Bg}" />

        <FlexLayout x:Name="PegRow" Grid.Row="5" JustifyContent="SpaceBetween" AlignItems="Center" Margin="6,26,6,0"
                    BindableLayout.ItemsSource="{Binding Pegs}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="vm:PegItem">
                    <Grid WidthRequest="50" HeightRequest="50">
                        <Border WidthRequest="46" HeightRequest="46" StrokeShape="RoundRectangle 23" Padding="0" HorizontalOptions="Center" VerticalOptions="Center"
                                BackgroundColor="{t:Theme Surface2}" Stroke="{t:Theme Surface2}" StrokeThickness="2">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsActive}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{t:Theme Surface1}" />
                                    <Setter Property="Stroke" Value="{t:Theme Accent}" />
                                    <Setter Property="StrokeThickness" Value="2.5" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsTuned}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{t:Theme Fill}" />
                                    <Setter Property="Stroke" Value="{t:Theme Fill}" />
                                </DataTrigger>
                                <MultiTrigger TargetType="Border">
                                    <MultiTrigger.Conditions>
                                        <BindingCondition Binding="{Binding IsTuned}" Value="True" />
                                        <BindingCondition Binding="{Binding IsActive}" Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Stroke" Value="{t:Theme TextPri}" />
                                    <Setter Property="StrokeThickness" Value="3" />
                                </MultiTrigger>
                            </Border.Triggers>
                            <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="1">
                                <Label Text="{Binding Label}" FontSize="16" FontAttributes="Bold" TextColor="{t:Theme TextSec}" VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="TextColor" Value="{t:Theme AccentText}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsTuned}" Value="True">
                                            <Setter Property="TextColor" Value="{t:Theme OnFill}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Text="{Binding Sub}" FontSize="10" TextColor="{t:Theme TextSec}" VerticalOptions="End" Margin="0,0,0,3">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsTuned}" Value="True">
                                            <Setter Property="TextColor" Value="{t:Theme OnFill}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </HorizontalStackLayout>
                        </Border>
                        <!-- Lock badge: the string is pinned by hand (tap again to release). -->
                        <Border WidthRequest="20" HeightRequest="20" StrokeShape="RoundRectangle 10" Padding="0" StrokeThickness="2"
                                Stroke="{t:Theme Bg}" BackgroundColor="{t:Theme TextPri}"
                                HorizontalOptions="End" VerticalOptions="End" IsVisible="{Binding IsLocked}">
                            <controls:IconView Name="lock" Size="11" Color="{t:Theme Bg}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding TapPegCommand, Source={RelativeSource AncestorType={x:Type vm:TunerViewModel}}}"
                                                  CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </FlexLayout>

        <Button Grid.Row="6" Command="{Binding ToggleCommand}" Margin="0,22,0,0" Text="{loc:Str Common_Listen}">
            <Button.Triggers>
                <DataTrigger TargetType="Button" Binding="{Binding AllTuned}" Value="True">
                    <Setter Property="Text" Value="{loc:Str Tuner_StartAgain}" />
                </DataTrigger>
                <DataTrigger TargetType="Button" Binding="{Binding Listening}" Value="True">
                    <Setter Property="Text" Value="{loc:Str Common_Stop}" />
                    <Setter Property="BackgroundColor" Value="{t:Theme Surface2}" />
                    <Setter Property="TextColor" Value="{t:Theme TextPri}" />
                </DataTrigger>
            </Button.Triggers>
        </Button>
    </Grid>
</ContentView>
